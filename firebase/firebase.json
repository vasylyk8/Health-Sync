{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        "test",
        "**/*.test.ts",
        ".git"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json",
    "location": "eur3"
  },
  "storage": [
    {
      "target": "incoming",
      "rules": "storage.rules"
    }
  ],
  "hosting": {
    "public": "hosting",
    "cleanUrls": true,
    "headers": [
      {
        "source": "/mcp/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/mcp/**",
        "function": {
          "functionId": "mcp",
          "region": "europe-west1"
        }
      },
      {
        "source": "/healthz",
        "function": {
          "functionId": "healthz",
          "region": "europe-west1"
        }
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099,
      "host": "127.0.0.1"
    },
    "firestore": {
      "port": 8080,
      "host": "127.0.0.1"
    },
    "storage": {
      "port": 9199,
      "host": "127.0.0.1"
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}