{
  "name": "health-sync-functions",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run test/unit",
    "test:emulator": "cd .. && firebase emulators:exec --only firestore,storage,auth --project demo-health-sync 'cd functions && vitest run test/integration'",
    "test:browser": "cd .. && firebase emulators:exec --only auth --project demo-health-sync 'cd functions && playwright test'",
    "prebuild": "node scripts/copy-shared.mjs && node scripts/build-connect.mjs",
    "pretypecheck": "node scripts/copy-shared.mjs",
    "pretest": "node scripts/copy-shared.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.31.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "basic-ftp": "6.2.1",
    "gaxios@6": { "uuid": "11.1.1" }
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.5-r.5",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "express": "^4.22.3",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "zod": "^4.6.5"
  }
}
