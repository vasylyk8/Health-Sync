rules_version = '2';
// Clients may only READ their own status documents. Every write goes through Cloud Functions,
// so catalogs, coverage, connections and links are server-owned and cannot be forged.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      match /types/{type} {
        allow read: if request.auth != null && request.auth.uid == uid;
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
