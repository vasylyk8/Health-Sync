# Automated build, test and TestFlight upload. Runs on GitHub's macOS machines; no Mac needed.
# Credentials come from environment variables set by the GitHub workflow (see docs/SETUP.md).
require "fileutils"
require "tmpdir"

default_platform(:ios)

PROJECT = "HealthSync.xcodeproj"
SCHEME = "HealthSync"

def api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY_P8"),
    in_house: false
  )
end

platform :ios do
  desc "Generate the Xcode project"
  lane :generate do
    sh("cd .. && xcodegen generate --spec project.yml")
  end

  desc "Unit + UI tests on the simulator (no signing). Saves screenshots as test attachments."
  lane :test do
    generate
    run_tests(
      project: PROJECT,
      scheme: SCHEME,
      device: ENV.fetch("SIM_DEVICE", "iPhone 16 Pro"),
      result_bundle: true,
      output_directory: "fastlane/test_output",
      # Ad-hoc simulator signing keeps entitlements (HealthKit) without an Apple account.
      xcargs: "CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY=- DEVELOPMENT_TEAM= PROVISIONING_PROFILE_SPECIFIER=",
      fail_build: true
    )
  end

  desc "Build, sign with Apple's cloud-managed distribution certificate, verify, upload to TestFlight"
  # No certificate is created, imported or revoked. The archive is built unsigned (Xcode refuses
  # ad-hoc signing for device SDKs), then signed ad-hoc with `codesign` so it carries the app's
  # entitlements, and `xcodebuild -exportArchive` re-signs it through Apple's cloud signing using the
  # App Store Connect API key (Admin role). SIGNING_MODE=xcode lets Xcode manage signing entirely
  # (may create an "Apple Development" certificate) if cloud export is refused.
  lane :beta do
    key = api_key
    bundle = ENV.fetch("BUNDLE_ID")
    team = ENV.fetch("APPLE_TEAM_ID")
    setup_ci
    generate
    root = File.expand_path("..", __dir__)
    build_dir = File.join(root, "build")
    archive = File.join(build_dir, "KROK.xcarchive")
    key_path = File.join(build_dir, "AuthKey.p8")
    FileUtils.mkdir_p(build_dir)
    File.write(key_path, ENV.fetch("ASC_KEY_P8"))
    auth = "-allowProvisioningUpdates -authenticationKeyPath #{key_path.shellescape} -authenticationKeyID #{ENV.fetch('ASC_KEY_ID')} -authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}"

    latest = latest_testflight_build_number(api_key: key, app_identifier: bundle, initial_build_number: 0)
    increment_build_number(xcodeproj: PROJECT, build_number: latest + 1)

    if ENV["SIGNING_MODE"] == "xcode"
      build_app(
        project: PROJECT, scheme: SCHEME, configuration: "Release", export_method: "app-store",
        export_options: { signingStyle: "automatic", teamID: team, uploadSymbols: true, manageAppVersionAndBuildNumber: false },
        xcargs: "#{auth} DEVELOPMENT_TEAM=#{team} CODE_SIGN_STYLE=Automatic", export_xcargs: auth,
        skip_profile_detection: true, output_directory: build_dir
      )
      ipa = lane_context[SharedValues::IPA_OUTPUT_PATH]
    else
      build_app(
        project: PROJECT, scheme: SCHEME, configuration: "Release",
        archive_path: archive, skip_package_ipa: true, skip_profile_detection: true,
        xcargs: "CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO CODE_SIGN_IDENTITY= DEVELOPMENT_TEAM=#{team}"
      )
      sign_archive_adhoc(archive, File.join(root, "HealthSync", "HealthSync.entitlements"))
      options = File.join(build_dir, "ExportOptions.plist")
      File.write(options, <<~PLIST)
        <?xml version="1.0" encoding="UTF-8"?>
        <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
        <plist version="1.0"><dict>
          <key>method</key><string>app-store-connect</string>
          <key>destination</key><string>export</string>
          <key>signingStyle</key><string>automatic</string>
          <key>teamID</key><string>#{team}</string>
          <key>uploadSymbols</key><true/>
          <key>manageAppVersionAndBuildNumber</key><false/>
        </dict></plist>
      PLIST
      sh("xcodebuild -exportArchive -archivePath #{archive.shellescape} -exportPath #{build_dir.shellescape} -exportOptionsPlist #{options.shellescape} #{auth}")
      ipa = Dir[File.join(build_dir, "*.ipa")].first or UI.user_error!("Export produced no .ipa")
    end
    verify_entitlements(ipa)
    upload_to_testflight(api_key: key, ipa: ipa, app_identifier: bundle, skip_waiting_for_build_processing: false, distribute_external: false)
    add_internal_testers(key)
  ensure
    File.delete(key_path) if key_path && File.exist?(key_path)
  end

  # Signs the archived app ad-hoc (nested code first) so the archive records its entitlements.
  def sign_archive_adhoc(archive, entitlements)
    app = Dir[File.join(archive, "Products", "Applications", "*.app")].first or UI.user_error!("No .app in archive")
    nested = Dir[File.join(app, "Frameworks", "*.{framework,dylib}")] + Dir[File.join(app, "PlugIns", "*.appex")]
    nested.each { |path| sh("codesign --force --sign - --timestamp=none #{path.shellescape}") }
    sh("codesign --force --sign - --timestamp=none --generate-entitlement-der --entitlements #{entitlements.shellescape} #{app.shellescape}")
    sh("codesign -d --entitlements :- #{app.shellescape}")
  end

  # Refuse to upload an app whose signature lost its HealthKit entitlement.
  private_lane :verify_entitlements do |ipa|
    Dir.mktmpdir do |dir|
      sh("unzip -q #{ipa.shellescape} -d #{dir.shellescape}")
      app = Dir[File.join(dir, "Payload", "*.app")].first
      ents = sh("codesign -d --entitlements :- #{app.shellescape} 2>/dev/null", log: false)
      UI.user_error!("Signed app is missing the HealthKit entitlement") unless ents.include?("com.apple.developer.healthkit")
      UI.user_error!("Signed app is missing App Attest") unless ents.include?("com.apple.developer.devicecheck.appattest-environment")
      UI.success("Entitlements verified (HealthKit, App Attest)")
    end
  end

  # Best effort: if Apple's API refuses, the build is still on TestFlight and the owner can add
  # testers with one click (App Store Connect > TestFlight > Team). The run log says so.
  private_lane :add_internal_testers do |key|
    emails = ENV.fetch("TESTER_EMAILS", "").split(",").map(&:strip).reject(&:empty?)
    next if emails.empty?
    begin
      Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: key)
      app = Spaceship::ConnectAPI::App.find(ENV.fetch("BUNDLE_ID"))
      group = app.get_beta_groups.find { |g| g.name == "Team" } ||
              app.create_beta_group(group_name: "Team", is_internal_group: true, has_access_to_all_builds: true)
      File.write("asc_key.json", JSON.dump(key))
      emails.each do |email|
        sh("fastlane pilot add #{email.shellescape} --groups Team --app_identifier #{ENV.fetch('BUNDLE_ID').shellescape} --api_key_path asc_key.json") rescue UI.important("Could not add #{email}; add them in App Store Connect > TestFlight")
      end
      UI.success("TestFlight group 'Team' has #{emails.count} tester(s) requested")
    rescue => e
      UI.important("Automatic tester setup failed (#{e.class}). Add testers manually in App Store Connect > TestFlight.")
    ensure
      File.delete("asc_key.json") if File.exist?("asc_key.json")
    end
  end
end
