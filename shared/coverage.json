{
 "version": 2,
 "note": "KROK syncs workouts (with all raw data) and daily context only. Shared by the iOS app and the server.",
 "excluded": {
  "everything else": "v2: only workouts and daily context are synced (owner decision)",
  "SexualActivity/Contraceptive/Pregnancy*/Lactation/Progesterone*/Bleeding*Pregnancy": "data minimisation: only menstrual-cycle context is read",
  "HKClinicalType*": "clinical records excluded",
  "ECG/heartbeat series/audiograms": "not workout data"
 },
 "types": [
  {
   "id": "HKWorkoutTypeIdentifier",
   "kind": "workout",
   "group": "workouts",
   "record": "w"
  },
  {
   "id": "_daily",
   "kind": "daily",
   "group": "daily",
   "record": "day"
  },
  {
   "id": "_wstream",
   "kind": "workoutdata",
   "group": "workouts",
   "record": "ws"
  }
 ],
